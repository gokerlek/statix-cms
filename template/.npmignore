# Template-scoped npm publish ignore.
# Root .npmignore also exists; both are checked but having one here
# ensures patterns resolve unambiguously when the package is packed.

# Build / dev artifacts
package-lock.json
tsconfig.tsbuildinfo
.next/
coverage/
node_modules/

# Maintainer dev state
local.db
local.db-journal

# Real env values (only .env.example may ship)
.env
.env.local
.env.*.local
.env.development
.env.production

# Upstream repo metadata — belongs to the Statix CMS source repository,
# not to every scaffolded user project. The user gets a per-project
# README generated by bin/index.js; they author their own CHANGELOG /
# CONTRIBUTING / SECURITY if and when they need them.
CHANGELOG.md
CONTRIBUTING.md
SECURITY.md
CODE_OF_CONDUCT.md
docs/

# IDE / editor / Claude / OMC workspaces — never ship
.claude/
.omc/
.idea/
.vscode/

# README is generated per-project by bin/index.js, not shipped
README.md

# `.github` ships as `_github`, renamed by bin/index.js
.github/

# Husky was removed from the template — guard against accidental reintro
.husky/
.lintstagedrc.json
